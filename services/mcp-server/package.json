{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "Servidor MCP de solo lectura sobre el control de acceso",
  "private": true,
  "type": "module",
  "bin": {
    "detector-mcp": "dist/main.js"
  },
  "scripts": {
