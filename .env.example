# ══════════════════════════════════════════════════════════════════
#  backend_detector — variables de entorno
#
#  Copiar a .env y rellenar. NUNCA subir .env al repositorio.
#
#  Los valores sensibles se dejan VACIOS a proposito: un marcador
#  copiable como "cambiar_esta_password" acaba llegando a produccion
#  sin cambiar. Si falta alguno, el servicio correspondiente se niega
#  a arrancar y dice cual.
#
#  Generar secretos:
#    openssl rand -base64 24    contrasenas de base de datos
#    openssl rand -base64 48    JWT_SECRET (minimo 32 caracteres)
# ══════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=facedetector
POSTGRES_PASSWORD=
POSTGRES_DB=face_access
# 5433 y no 5432: es habitual tener ya un PostgreSQL nativo instalado
# ocupando el puerto por defecto. Dentro de Docker se sigue usando 5432.
POSTGRES_PORT=5433

# Cada servicio usa su propio rol y su propio schema.
FACE_DATABASE_URL=postgresql://face_svc_user:<POSTGRES_PASSWORD>@localhost:5433/face_access?schema=face_svc
ACCESS_DATABASE_URL=postgresql://access_svc_user:<POSTGRES_PASSWORD>@localhost:5433/face_access?schema=access_svc
AUTH_DATABASE_URL=postgresql://auth_svc_user:<POSTGRES_PASSWORD>@localhost:5433/face_access?schema=auth_svc
SHIFT_DATABASE_URL=postgresql://shift_svc_user:<POSTGRES_PASSWORD>@localhost:5433/face_access?schema=shift_svc

FACE_SVC_DB_PASSWORD=
ACCESS_SVC_DB_PASSWORD=
AUTH_SVC_DB_PASSWORD=
SHIFT_SVC_DB_PASSWORD=

# ── Puertos de los servicios ──────────────────────────────────────
GATEWAY_PORT=3000
FACE_SERVICE_PORT=3001
ACCESS_SERVICE_PORT=3002
AUTH_SERVICE_PORT=3003
SHIFT_SERVICE_PORT=3004
VISION_SERVICE_PORT=8000

# ── URLs internas (service discovery por DNS de Docker) ───────────
VISION_SERVICE_URL=http://localhost:8000
FACE_SERVICE_URL=http://localhost:3001
ACCESS_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3003
SHIFT_SERVICE_URL=http://localhost:3004

# ── Seguridad ─────────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Proteccion de las rutas /admin/*. Debe estar en true salvo que sepas
# muy bien por que la desactivas.
ADMIN_AUTH_ENABLED=true
ADMIN_TOKEN_EXPIRES_IN=8h

# Primera cuenta de administracion. Se crea SOLO si no existe ninguna.
# Minimo 12 caracteres, o el servicio se niega a crearla.
# Genera una con: openssl rand -base64 18
ADMIN_BOOTSTRAP_EMAIL=admin@detector.local
ADMIN_BOOTSTRAP_NAME=Administrador
ADMIN_BOOTSTRAP_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=600

# ── Vision Service ────────────────────────────────────────────────
# Backend de detección: 'yolo' (rostros.pt propio) | 'scrfd' (InsightFace)
FACE_DETECTOR_BACKEND=yolo
YOLO_FACE_MODEL_PATH=/app/modelos/rostros.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_IOU_THRESHOLD=0.45
YOLO_IMAGE_SIZE=640

# Modelo de embeddings (InsightFace)
INSIGHTFACE_MODEL_PACK=buffalo_l
EMBEDDING_MODEL_NAME=buffalo_l/w600k_r50
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DIM=512

# Calidad mínima aceptada para procesar un rostro
MIN_FACE_SIZE_PX=80
MIN_DETECTION_SCORE=0.50
# Nitidez minima. Se mide sobre el recorte normalizado a 112x112, asi que
# el valor no depende de la resolucion de la camara. Calibrar en destino.
MIN_BLUR_SCORE=12.0
MAX_IMAGE_SIZE_MB=8

# ── Redis: bus de eventos y estado compartido ─────────────────────
# 6380 y no 6379 por el mismo motivo que PostgreSQL usa 5433: es
# habitual tener ya un Redis nativo en el puerto por defecto.
REDIS_PORT=6380
# Desde el host. Dentro de Docker cada servicio usa redis://redis:6379.
REDIS_URL=redis://localhost:6380
# Donde viven las ventanas de votacion: 'redis' las comparte entre
# replicas, 'memory' las deja en el proceso (comportamiento original).
VOTE_WINDOW_BACKEND=redis

# ── Anti-passback (Access Service) ────────────────────────────────
# Dos lecturas del mismo rostro en la misma puerta dentro de esta
# ventana son el mismo paso. Sin ella, quedarse delante del lector
# generaria un paso nuevo cada pocas decimas de segundo.
ANTIPASSBACK_GRACE_SECONDS=10

# ── Outbox de eventos (Access Service) ────────────────────────────
# Cada cuanto el relay busca eventos sin publicar y cuantos manda de
# una vez. Con varias replicas se reparten la cola con SKIP LOCKED, asi
# que no hace falta designar una sola que publique.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# Los eventos YA publicados se borran pasado este tiempo. Los que
# siguen pendientes no se tocan: eso es una averia, no basura.
OUTBOX_RETENTION_HOURS=168
OUTBOX_MAX_ATTEMPTS=10

# ── Jornada laboral (Shift Service) ───────────────────────────────
# Salir de la sede abre una PAUSA, no cierra la jornada: en ese momento
# nadie puede saber si la persona volvera. Pasado este tiempo sin que
# vuelva, la pausa se convierte en el cierre de la jornada, con la hora
# de la salida y no la de ahora.
SHIFT_PAUSE_TIMEOUT_MINUTES=90
# Una jornada abierta mas tiempo que esto es alguien que se fue sin
# fichar. Se cierra al ultimo movimiento conocido y se marca, para que
# la hoja de horas no muestre jornadas de tres dias.
SHIFT_MAX_HOURS=16
RECONCILER_INTERVAL_MS=60000

# ── Política de reconocimiento (Access Service) ───────────────────
# Similitud coseno mínima. CALIBRAR con datos reales (ver docs/adr/0003).
RECOGNITION_THRESHOLD=0.38
# Votación multi-frame: N coincidencias sobre M frames
RECOGNITION_VOTES_REQUIRED=3
RECOGNITION_WINDOW_SIZE=5
RECOGNITION_WINDOW_TTL_MS=10000

# ── Frontend (prefijo VITE_ obligatorio para exponerlas) ──────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_CAPTURE_FPS=5

# ── Capacidad del Vision Service ──────────────────────────────────
#
# Procesos de inferencia y nucleos por proceso. El defecto de UNO
# no es pereza: con 12 nucleos, el segundo worker no mejora nada
# medible y duplica la memoria, porque una sola inferencia de torch
# ya usa la mitad de la maquina. En hardware con mas nucleos puede
# compensar, pero mide antes de subirlo.
VISION_WORKERS=1
# Vacio = lo decide torch (la mitad de los nucleos). Solo hace falta
# ponerle un numero si subes VISION_WORKERS por encima de 1.
VISION_THREADS_PER_WORKER=

# ── Observabilidad (Fase 4) ───────────────────────────────────────
#
# Los seis servicios exportan trazas y metricas al Collector, y de ahi
# salen a Tempo y a Prometheus. Nada de esto es una dependencia: si el
# Collector no responde, los servicios descartan telemetria en silencio
# y las puertas siguen abriendose.

# A donde exportan los servicios. Vacio o ausente = telemetria apagada.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Interruptor general. Ponlo a true para arrancar sin instrumentacion,
# por ejemplo para descartar que un problema venga de ella.
OTEL_SDK_DISABLED=false

# Fraccion de trazas que se conservan. 1 = todas, que es lo correcto en
# una demostracion. En produccion esto seria muestreo por cola, para
# quedarse con las lentas y las que fallan en lugar de con una de cada
# N al azar.
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# Distingue este despliegue en los paneles.
OTEL_DEPLOYMENT_ENVIRONMENT=local

# Puertos en el host. 3001 para Grafana porque el 3000 lo ocupa el
# Gateway, igual que PostgreSQL usa el 5433.
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# Acceso a Grafana. Cambialo: con estas credenciales entra cualquiera
# que alcance el puerto.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Voz e IA (Fase 5) ─────────────────────────────────────────────
# Generar en el panel de Deepgram (API Keys) y de Google AI Studio.
# NUNCA la contrasena de la cuenta: siempre una API key revocable.
DEEPGRAM_API_KEY=
GEMINI_API_KEY=

# Puerta fisica donde esta montado este terminal. Debe coincidir con
# el terminal_key de un access_point. NO lo elige el usuario.
VITE_TERMINAL_KEY=main-entrance
