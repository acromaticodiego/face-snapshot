# ══════════════════════════════════════════════════════════════════
#  Servicios NestJS CON base de datos (face-service, access-service).
#
#  Diferencias respecto a Dockerfile.nest:
#    · genera el cliente de Prisma durante la construcción
#    · conserva el CLI de Prisma y el directorio prisma/ en la imagen
#      final, para poder ejecutar migraciones dentro del contenedor:
#          docker compose exec face-service npx prisma migrate deploy
# ══════════════════════════════════════════════════════════════════

FROM node:24-alpine AS builder

WORKDIR /app

COPY package*.json ./

# npm 11 bloquea por defecto los scripts de instalación. Prisma los
# necesita para preparar su motor, así que se permiten explícitamente
# durante la construcción de la imagen.
RUN npm ci --ignore-scripts=false

COPY . .

RUN npx prisma generate
RUN npm run build

# Se podan las dependencias de desarrollo y se REGENERA el cliente:
# `npm prune` puede llevarse por delante el directorio generado
# node_modules/.prisma, que no pertenece a ningún paquete declarado.
RUN npm prune --omit=dev \
    && npx prisma generate


# ── Imagen final ──────────────────────────────────────────────────
FROM node:24-alpine

RUN apk add --no-cache curl

ENV NODE_ENV=production

WORKDIR /app

COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --from=builder --chown=node:node /app/package.json ./

# Necesarios para ejecutar migraciones dentro del contenedor.
COPY --from=builder --chown=node:node /app/prisma ./prisma
COPY --from=builder --chown=node:node /app/prisma.config.ts ./

USER node

ARG PORT=3000
ENV PORT=${PORT}
EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:${PORT}/api/v1/health || exit 1

CMD ["node", "dist/main"]
