# ── Secretos ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Node ──────────────────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
.npm/

# ── Python ────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Modelos y pesos ───────────────────────────────────────────────
# rostros.pt SÍ se versiona (es el modelo del proyecto, 22 MB).
# Los pesos descargados de InsightFace NO: se bajan en build.
modelos/insightface/
modelos/*.onnx
~/.insightface/

# ── Datos biometricos y multimedia (NUNCA al repositorio) ─────────
#
# Se ignoran las imagenes en general para que no acabe subida una foto
# de alguien por accidente. Las carpetas de assets se excluyen de la
# regla mas abajo: ahi van iconos y logos, no rostros.
*.jpg
*.jpeg
*.png
*.bmp
*.mp4
*.avi
*.mov
*.npy
*.pkl

# Directorios de datos sensibles, anclados a la raiz del proyecto.
/captures/
/embeddings/
/dumps/

# Excepciones: recursos de la interfaz y de la documentacion.
!docs/**/*.png
!frontend/public/**
!frontend/src/assets/**

# ── Base de datos ─────────────────────────────────────────────────
postgres-data/
*.sql.gz
*.dump

# ── Editor / SO ───────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Temporales ────────────────────────────────────────────────────
#
# ANCLADOS A LA RAIZ CON "/" A PROPOSITO.
#
# Sin la barra inicial, `logs/` coincide con CUALQUIER directorio
# llamado "logs" a cualquier profundidad. Eso llego a ignorar el codigo
# fuente de services/access-service/src/logs/, que compilaba en local
# porque los archivos estaban en disco, pero faltaba en el repositorio
# y rompia la integracion continua. El mismo riesgo tienen tmp y temp.
/tmp/
/temp/
/logs/
*.log
